{
  "schema_version": 1,
  "purpose": "Selector contract only. It does not authorize changing protected mother-template files or inserting new DOM structures. Renderer must preserve wrappers, tabs, disclosures, links and card geometry.",
  "templates": {
    "monday": {
      "path": "母版專區/TAC_母版_週一_2026-10-28_最終定版.html",
      "sections": {
        "summary": {
          "container": "main.wrap > section.grid.two article.bluf",
          "headline": "h1",
          "body": "p",
          "mode": "replace_text_only"
        },
        "market_sentiment": {
          "container": "#sentiment",
          "mode": "market_snapshot_slots_only"
        },
        "focus_news": {
          "container": "#global-focus",
          "items": ".newsitem",
          "headline": "h3",
          "summary": "p",
          "source_links": ".newsmeta a",
          "expected_count": 5,
          "mode": "replace_existing_items_only"
        },
        "market_headlines": {
          "container": "#headlines",
          "items": ".newsitem",
          "headline": "h3",
          "summary": "p",
          "source_links": ".newsmeta a",
          "expected_count": 10,
          "mode": "replace_existing_items_only"
        },
        "last_week_economic_calendar": {
          "container": "#last-week-calendar",
          "collapse": "details.last-week-calendar-collapse",
          "items": "details.econ-event",
          "expected_importance_stars": 3,
          "mode": "preserve_event_card_structure"
        },
        "last_week_earnings_calendar": {
          "container": "#last-week-earnings",
          "collapse": "details.last-week-earnings-collapse",
          "items": "details.earnings-accordion",
          "importance_rule": "only_source_native_3_star_events",
          "mode": "preserve_event_card_structure"
        },
        "economic_calendar": {
          "container": "#calendar",
          "items": ".econ-event",
          "tabs": ".week-econ-tabs",
          "expected_importance_stars": 3,
          "mode": "preserve_tab_and_event_card_structure"
        },
        "earnings_calendar": {
          "container": "#earnings",
          "items": ".earnings-accordion",
          "tabs": ".week-earnings-tabs",
          "expected_importance_stars": 3,
          "mode": "preserve_tab_and_event_card_structure"
        },
        "market_observation_highlights": {
          "container": "#view",
          "mode": "replace_existing_text_nodes_only"
        }
      }
    },
    "weekday": {
      "path": "母版專區/TAC_母版_週二至週五_2026-10-28_最終定版.html",
      "sections": {
        "summary": {
          "container": "main.wrap > section.grid.two article.bluf",
          "headline": "h1",
          "body": "p",
          "mode": "replace_text_only"
        },
        "market_sentiment": {
          "container": "#sentiment",
          "mode": "market_snapshot_slots_only"
        },
        "focus_news": {
          "container": "#global-focus",
          "items": ".newsitem",
          "headline": "h3",
          "summary": "p",
          "source_links": ".newsmeta a",
          "expected_count": 5,
          "mode": "replace_existing_items_only"
        },
        "market_headlines": {
          "container": "#headlines",
          "items": ".newsitem",
          "headline": "h3",
          "summary": "p",
          "source_links": ".newsmeta a",
          "expected_count": 10,
          "mode": "replace_existing_items_only"
        },
        "economic_calendar": {
          "container": "#calendar",
          "items": ".econ-event",
          "tabs": ".week-econ-tabs",
          "expected_importance_stars": 3,
          "mode": "preserve_tab_and_event_card_structure"
        },
        "earnings_calendar": {
          "container": "#earnings",
          "items": ".earnings-accordion",
          "tabs": ".week-earnings-tabs",
          "expected_importance_stars": 3,
          "mode": "preserve_tab_and_event_card_structure"
        },
        "market_observation_highlights": {
