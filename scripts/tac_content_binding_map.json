{
  "schema_version": 1,
  "purpose": "Selector contract only. It does not authorize changing protected mother-template files or inserting new DOM structures. Renderer must preserve wrappers, tabs, disclosures, links and card geometry.",
  "templates": {
    "monday": {
      "path": "母版專區/TAC_母版_週一_2026-10-28_最終定版.html",
      "sections": {
        "summary": {
          "container": "main.wrap > section.grid.two article.bluf",
          "headline": "h1",
          "body": "p",
          "mode": "replace_text_only",
          "schema_fields": {
            "headline": "analysis.summary.headline",
            "body": "analysis.summary.text"
          }
        },
        "market_sentiment": {
          "container": "#sentiment",
          "mode": "market_snapshot_slots_only"
        },
        "focus_news": {
          "container": "#global-focus",
          "items": ".newsitem",
          "headline": "h3",
          "summary": "p",
          "source_links": ".newsmeta a",
          "expected_count": 5,
          "mode": "replace_existing_items_only"
        },
        "market_headlines": {
          "container": "#headlines",
          "items": ".newsitem",
          "headline": "h3",
          "summary": "p",
          "source_links": ".newsmeta a",
          "expected_count": 10,
          "mode": "replace_existing_items_only"
        },
        "last_week_economic_calendar": {
          "container": "#last-week-calendar",
          "collapse": "details.last-week-calendar-collapse",
          "items": "details.econ-event",
          "expected_importance_stars": 3,
          "mode": "preserve_event_card_structure",
          "schema_fields": "previous_economic_calendar"
        },
        "last_week_earnings_calendar": {
          "container": "#last-week-earnings",
          "collapse": "details.last-week-earnings-collapse",
          "items": "details.earnings-accordion",
          "importance_rule": "source_native_3_star_if_explicit_else_unrated_traceable_major_event_assessment",
          "mode": "preserve_event_card_structure",
          "schema_fields": "previous_earnings_calendar"
        },
        "economic_calendar": {
          "container": "#calendar",
          "items": ".econ-event",
          "tabs": ".week-econ-tabs",
          "expected_importance_stars": 3,
          "mode": "preserve_tab_and_event_card_structure",
          "schema_fields": "economic_calendar"
        },
        "earnings_calendar": {
          "container": "#earnings",
          "items": ".earnings-accordion",
          "tabs": ".week-earnings-tabs",
          "mode": "preserve_tab_and_event_card_structure",
          "importance_rule": "source_native_3_star_if_explicit_else_unrated_traceable_major_event_assessment",
          "schema_fields": "earnings_calendar"
        },
        "market_observation_highlights": {
          "container": "#view",
          "mode": "update_existing_panel_content_without_replacing_tab_or_disclosure_wrappers",
          "panels": {
            "market_view": {
              "selector": ".focus-panel.focus-market .key",
              "schema_field": "analysis.market_observation_highlights.market_view"
            },
            "key_levels": {
              "selector": ".focus-panel.focus-levels .key",
              "schema_field": "analysis.market_observation_highlights.key_levels"
            },
            "core_observations": {
              "selector": ".focus-panel.focus-core .callout",
              "schema_field": "analysis.market_observation_highlights.core_observations"
            }
          },
          "preserve_nested_disclosures": true
        }
      }
    },
    "weekday": {
      "path": "母版專區/TAC_母版_週二至週五_2026-10-28_最終定版.html",
      "sections": {
