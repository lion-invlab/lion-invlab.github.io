            "headline": "analysis.summary.headline",
            "body": "analysis.summary.text"
          }
        },
        "market_sentiment": {
          "container": "#sentiment",
          "mode": "market_snapshot_slots_only"
        },
        "focus_news": {
          "container": "#global-focus",
          "items": ".newsitem",
          "headline": "h3",
          "summary": "p",
          "source_links": ".newsmeta a",
          "expected_count": 5,
          "mode": "replace_existing_items_only"
        },
        "market_headlines": {
          "container": "#headlines",
          "items": ".newsitem",
          "headline": "h3",
          "summary": "p",
          "source_links": ".newsmeta a",
          "expected_count": 10,
          "mode": "replace_existing_items_only"
        },
        "economic_calendar": {
          "container": "#calendar",
          "items": ".econ-event",
          "tabs": ".week-econ-tabs",
          "expected_importance_stars": 3,
          "mode": "preserve_tab_and_event_card_structure",
          "schema_fields": "economic_calendar"
        },
        "earnings_calendar": {
          "container": "#earnings",
          "items": ".earnings-accordion",
          "tabs": ".week-earnings-tabs",
