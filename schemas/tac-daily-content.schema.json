{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lion-invlab.github.io/schemas/tac-daily-content.schema.json",
  "title": "TAC Daily Editorial Content",
  "description": "Validated editorial content contract for TAC daily reports. Contains source-grounded news, calendar events with native 1–3 star importance ratings, earnings results, and analysis inputs. Does not define or override source priority in TAC_WORK_RULES.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "meta",
    "focus_news",
    "market_headlines",
    "economic_calendar",
    "earnings_calendar",
    "analysis"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "report_date",
        "trading_date",
        "generated_at",
        "timezone",
        "wr_version",
        "template_type"
      ],
      "properties": {
        "report_date": {
          "type": "string",
          "format": "date"
        },
        "trading_date": {
          "type": "string",
          "format": "date"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "const": "Asia/Taipei"
        },
        "wr_version": {
          "const": "3.5"
        },
        "template_type": {
          "enum": [
            "monday",
            "weekday"
          ]
        },
        "news_window_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "news_window_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "focus_news": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/newsItem"
      }
    },
    "market_headlines": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/newsItem"
      }
    },
    "economic_calendar": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/economicEvent"
      }
    },
    "earnings_calendar": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/earningsEvent"
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "market_observation_highlights",
        "market_sentiment"
      ],
      "properties": {
        "summary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "source_refs",
            "status"
          ],
          "properties": {
            "text": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1800
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "status": {
              "$ref": "#/$defs/contentStatus"
            }
          }
        },
        "market_observation_highlights": {
          "type": "array",
          "minItems": 0,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "source_refs"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              }
            }
          }
        },
        "market_sentiment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "label",
            "score",
            "text",
            "source_refs",
            "status"
          ],
          "properties": {
            "label": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 40
            },
            "score": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 100
            },
            "text": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 1200
            },
            "source_refs": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "status": {
              "$ref": "#/$defs/contentStatus"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "contentStatus": {
      "enum": [
        "verified",
        "pending_verification",
        "missing",
        "not_applicable"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "url",
        "published_at",
        "observed_at"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "publisher": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "newsItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "headline",
        "summary",
        "published_at",
        "source",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "macro",
            "market",
            "company",
            "policy",
            "geopolitics",
            "other"
          ]
        },
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1200
        },
        "published_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "status": {
          "enum": [
            "verified",
            "pending_verification"
          ]
        },
        "impact": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        }
      }
    },
    "economicEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event_date",
        "region",
        "event_name",
        "importance_stars",
        "previous",
        "forecast",
        "actual",
        "status",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "event_date": {
          "type": "string",
          "format": "date-time"
        },
        "region": {
          "type": "string",
          "minLength": 1
        },
        "event_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "importance_stars": {
          "const": 5
        },
        "previous": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "forecast": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "actual": {
          "type": [
            "string",
            "number",
            "null"
          ]
        },
        "status": {
          "enum": [
            "upcoming",
            "released",
            "pending_verification"
          ]
        },
        "impact_judgment": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "earningsEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "event_date",
        "company",
        "ticker",
        "session",
        "importance_stars",
        "eps_estimate",
        "eps_actual",
        "revenue_estimate",
        "revenue_actual",
        "status",
        "source"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "event_date": {
          "type": "string",
          "format": "date-time"
        },
        "company": {
          "type": "string",
          "minLength": 1
        },
        "ticker": {
          "type": [
            "string",
            "null"
          ]
        },
        "session": {
          "enum": [
            "before_market",
            "after_market",
            "during_market",
            "unknown"
          ]
        },
        "importance_stars": {
          "const": 5
        },
        "eps_estimate": {
          "type": [
            "number",
            "null"
          ]
        },
        "eps_actual": {
          "type": [
            "number",
            "null"
          ]
        },
        "revenue_estimate": {
          "type": [
            "number",
            "null"
          ]
        },
        "revenue_actual": {
          "type": [
            "number",
            "null"
          ]
        },
        "status": {
          "enum": [
            "upcoming",
            "released",
            "pending_verification"
          ]
        },
        "stock_price_reaction": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 500
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    }
  }
}
