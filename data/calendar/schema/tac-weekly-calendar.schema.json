{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://lion-invlab.github.io/schemas/tac-weekly-calendar.schema.json",
  "title":"TAC Weekly Calendar Database",
  "type":"object",
  "required":["schema_version","timezone","week_id","week_start","week_end","wr_version","status","events","coverage","audit"],
  "properties":{
    "schema_version":{"const":1},
    "timezone":{"const":"Asia/Taipei"},
    "week_id":{"type":"string","pattern":"^[0-9]{4}-W[0-9]{2}$"},
    "week_start":{"type":"string","format":"date"},
    "week_end":{"type":"string","format":"date"},
    "created_at":{"type":"string","format":"date-time"},
    "updated_at":{"type":"string","format":"date-time"},
    "source_report_date":{"type":"string","format":"date"},
    "wr_version":{"type":"string"},
    "status":{"enum":["prototype","active","archived","archive_candidate"]},
    "events":{"type":"object","required":["economic","earnings"],"properties":{"economic":{"type":"array","items":{"$ref":"#/$defs/economicEvent"}},"earnings":{"type":"array","items":{"$ref":"#/$defs/earningsEvent"}}},"additionalProperties":false},
    "coverage":{"type":"object","required":["economic","earnings"],"properties":{"economic":{"$ref":"#/$defs/coverage"},"earnings":{"$ref":"#/$defs/coverage"}},"additionalProperties":false},
    "audit":{"type":"array","items":{"type":"object","required":["at","action"],"properties":{"at":{"type":"string","format":"date-time"},"action":{"type":"string"},"event_id":{"type":"string"},"source":{"type":"string"},"note":{"type":"string"}},"additionalProperties":true}}
  },
  "$defs":{
    "coverage":{"type":"object","required":["status"],"properties":{"status":{"enum":["complete","incomplete","not_applicable"]},"source_refs":{"type":"array","items":{"type":"string","format":"uri"}},"checked_at":{"type":"string","format":"date-time"},"notes":{"type":"string"}},"additionalProperties":true},
    "economicEvent":{"type":"object","required":["id","event_date","region","event_name","importance_stars","status","source"],"properties":{"id":{"type":"string","minLength":1},"event_date":{"type":"string","format":"date-time"},"region":{"type":"string"},"event_name":{"type":"string"},"importance_stars":{"type":"integer","minimum":1,"maximum":5},"status":{"enum":["upcoming","released","cancelled","postponed","pending_verification"]},"source":{"$ref":"#/$defs/source"}},"additionalProperties":true},
    "earningsEvent":{"type":"object","required":["id","company","event_date","status","importance_stars","source"],"properties":{"id":{"type":"string","minLength":1},"company":{"type":"string"},"event_date":{"type":"string","format":"date-time"},"status":{"enum":["upcoming","released","cancelled","postponed","pending_verification"]},"importance_stars":{"type":"integer","minimum":1,"maximum":5},"source":{"$ref":"#/$defs/source"}},"additionalProperties":true},
    "source":{"type":"object","required":["url"],"properties":{"name":{"type":"string"},"url":{"type":"string","format":"uri"},"published_at":{"type":["string","null"],"format":"date-time"},"observed_at":{"type":["string","null"],"format":"date-time"},"publisher":{"type":"string"},"notes":{"type":"string"}},"additionalProperties":true}
  },
  "additionalProperties":false
}