{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAC Stage 4 report content input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "report_date",
    "trading_date",
    "news_cutoff_taipei",
    "summary_title",
    "summary_points",
    "focus_news",
    "headlines",
    "sentiment",
    "market_analysis",
    "political_scan",
    "core_observation",
    "observation",
    "key_levels",
    "market_comments"
  ],
  "properties": {
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "trading_date": {
      "type": "string",
      "format": "date"
    },
    "news_cutoff_taipei": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
    },
    "summary_title": {
      "type": "string",
      "minLength": 8,
      "maxLength": 36
    },
    "summary_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "required": [
          "label",
          "text"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 20
          }
        },
        "additionalProperties": true
      }
    },
    "focus_news": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/news"
      }
    },
    "headlines": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/news"
      }
    },
    "sentiment": {
      "type": "string",
      "minLength": 20
    },
    "market_sentiment": {
      "type": [
        "string",
        "object"
      ]
    },
    "market_analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "political",
        "policy_industry",
        "macro",
        "markets",
        "strategy"
      ],
      "properties": {
        "political": {
          "$ref": "#/$defs/layer"
        },
        "policy_industry": {
          "$ref": "#/$defs/layer"
        },
        "macro": {
          "$ref": "#/$defs/layer"
        },
        "markets": {
          "$ref": "#/$defs/layer"
        },
        "strategy": {
          "$ref": "#/$defs/layer"
        }
      }
    },
    "political_scan": {
      "type": "object",
      "required": [
        "checked_at",
        "domains_checked",
        "findings"
      ],
      "properties": {
        "checked_at": {
          "type": "string"
        },
        "domains_checked": {
          "const": [
            "us_policy",
            "us_china",
            "geopolitics",
            "trade_sanctions",
            "major_economies",
            "energy_resources"
          ]
        },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "title",
              "domain",
              "classification",
              "source_url",
              "published_at",
              "checked_at",
              "transmission"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "domain": {
                "type": "string"
              },
              "classification": {
                "enum": [
                  "formally_effective",
                  "announced_not_implemented",
                  "political_statement",
                  "market_expectation",
                  "unverified"
                ]
              },
              "source_url": {
                "type": "string",
                "format": "uri"
              },
              "published_at": {
                "type": "string"
              },
              "checked_at": {
                "type": "string"
              },
              "transmission": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "no_material_change_note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "core_observation": {
      "type": "object",
      "required": [
        "heading",
        "text"
      ],
      "properties": {
        "heading": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 20
        },
        "details": {
          "type": "string"
        },
        "points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "text"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    },
    "observation": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": true
    },
    "key_levels": {
      "type": "object",
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "additionalProperties": true
    },
    "market_comments": {
      "type": "object",
      "required": [
        "global_markets"
      ],
      "properties": {
        "global_markets": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "string",
            "minLength": 20
          }
        },
        "sectors": {
          "type": "string"
        },
        "bonds": {
          "type": "string"
        },
        "fx": {
          "type": "string"
        },
        "energy": {
          "type": "string"
        },
        "metals": {
          "type": "string"
        },
        "risk": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "warning_note": {
      "type": "string"
    },
    "quality_note": {
      "type": "string"
    },
    "pending_items": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "news_window_taipei": {
      "type": "string"
    },
    "source_evidence_note": {
      "type": "string"
    },
    "earnings_health": {
      "type": "object",
      "required": [
        "source",
        "source_url",
        "as_of_date",
        "period",
        "reported_pct",
        "eps_beat_pct",
        "revenue_beat_pct",
        "blended_eps_yoy",
        "blended_revenue_yoy",
        "eps_surprise",
        "forward_pe",
        "interpretation"
      ],
      "properties": {
        "source": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "period": {
          "type": "string"
        },
        "reported_pct": {
          "type": "string"
        },
        "eps_beat_pct": {
          "type": "string"
        },
        "revenue_beat_pct": {
          "type": "string"
        },
        "blended_eps_yoy": {
          "type": "string"
        },
        "blended_revenue_yoy": {
          "type": "string"
        },
        "eps_surprise": {
          "type": "string"
        },
        "revenue_surprise": {
          "type": "string"
        },
        "forward_pe": {
          "type": "string"
        },
        "eps_beat_avg_5y": {
          "type": "string"
        },
        "eps_beat_avg_10y": {
          "type": "string"
        },
        "revenue_beat_avg_5y": {
          "type": "string"
        },
        "revenue_beat_avg_10y": {
          "type": "string"
        },
        "eps_surprise_avg_5y": {
          "type": "string"
        },
        "eps_surprise_avg_10y": {
          "type": "string"
        },
        "revenue_surprise_avg_5y": {
          "type": "string"
        },
        "forward_pe_avg_5y": {
          "type": "string"
        },
        "forward_pe_avg_10y": {
          "type": "string"
        },
        "prior_blended_eps_yoy": {
          "type": "string"
        },
        "prior_blended_revenue_yoy": {
          "type": "string"
        },
        "mag7_eps_growth": {
          "type": "string"
        },
        "other_493_eps_growth": {
          "type": "string"
        },
        "interpretation": {
          "type": "string",
          "minLength": 20
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "news": {
      "type": "object",
      "required": [
        "title",
        "summary",
        "url",
        "published_at_tw",
        "published_at_source",
        "source_timezone",
        "publisher"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 30
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "published_at_tw": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$"
        },
        "published_at_source": {
          "type": "string"
        },
        "source_timezone": {
          "type": "string",
          "minLength": 1
        },
        "updated_at_source": {
          "type": "string",
          "minLength": 1
        },
        "updated_at_tw": {
          "type": "string",
          "minLength": 1
        },
        "publisher": {
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "additionalProperties": true,
      "anyOf": [
        {
          "required": [
            "updated_at_source"
          ]
        },
        {
          "required": [
            "updated_at_tw"
          ]
        }
      ],
      "anyOf": [
        {
          "required": [
            "updated_at_source"
          ]
        },
        {
          "required": [
            "updated_at_tw"
          ]
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": [
        "label",
        "url",
        "status"
      ],
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "status": {
          "type": "string"
        },
        "published_at": {
          "type": "string"
        },
        "checked_at": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "layer": {
      "type": "object",
      "required": [
        "paragraphs",
        "sources"
      ],
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 20
          }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "supporting_market_rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "group",
              "name"
            ],
            "properties": {
              "group": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            }
          }
        }
      },
      "additionalProperties": true
    }
  }
}
