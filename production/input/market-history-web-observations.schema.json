{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TAC Stage 2 direct web observations",
  "type": "object",
  "required": [
    "schema_version",
    "report_date",
    "trading_date",
    "captured_at_utc",
    "stage2_wr_sha256",
    "observations",
    "fedwatch",
    "run_id",
    "stage1_receipt_sha256",
    "run_context_sha256",
    "stage1_fixture_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1"
    },
    "report_date": {
      "type": "string",
      "format": "date"
    },
    "trading_date": {
      "type": "string",
      "format": "date"
    },
    "captured_at_utc": {
      "type": "string"
    },
    "stage2_wr_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observations": {
      "type": "array",
      "minItems": 44,
      "maxItems": 44,
      "items": {
        "$ref": "#/$defs/observation"
      }
    },
    "run_id": {
      "type": "string",
      "pattern": "^TAC-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]+-[0-9]+$"
    },
    "stage1_receipt_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "run_context_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "stage1_fixture_sha256": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "fedwatch": {
      "type": "object",
      "required": [
        "status",
        "source_name",
        "source_url",
        "report_date",
        "trading_date",
        "captured_at_utc",
        "probabilities",
        "stage2_wr_sha256",
        "reason",
        "target_meeting",
        "current_target_range",
        "updated_at_tw",
        "web_reader_ref",
        "web_line_start",
        "web_line_end"
      ],
      "properties": {
        "status": {
          "enum": [
            "VERIFIED",
            "SOURCE_NO_DATA",
            "TOOL_READ_FAILURE"
          ]
        },
        "source_name": {
          "const": "Investing.com Fed Rate Monitor"
        },
        "source_url": {
          "const": "https://www.investing.com/central-banks/fed-rate-monitor"
        },
        "report_date": {
          "type": "string",
          "format": "date"
        },
        "trading_date": {
          "type": "string",
          "format": "date"
        },
        "captured_at_utc": {
          "type": "string"
        },
        "target_meeting": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "current_target_range": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_at_tw": {
          "type": [
            "string",
            "null"
          ]
        },
        "probabilities": {
          "type": "array",
          "minItems": 0,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "outcome",
              "rate_range",
              "probability"
            ],
            "properties": {
              "outcome": {
                "enum": [
                  "hold",
                  "cut",
                  "hike",
                  "維持不變",
                  "升息",
                  "降息"
                ]
              },
              "rate_range": {
                "type": "string",
                "minLength": 1
              },
              "probability": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": true
          }
        },
        "web_reader_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "web_line_start": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "web_line_end": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "stage2_wr_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "VERIFIED"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "probabilities": {
                "minItems": 1
              },
              "target_meeting": {
                "type": "string"
              },
              "current_target_range": {
                "type": "string"
              },
              "updated_at_tw": {
                "type": "string"
              },
              "web_reader_ref": {
                "type": "string"
              },
              "web_line_start": {
                "type": "integer"
              },
              "web_line_end": {
                "type": "integer"
              },
              "reason": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "SOURCE_NO_DATA",
                  "TOOL_READ_FAILURE"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "probabilities": {
                "maxItems": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "$defs": {
    "observation": {
      "type": "object",
      "required": [
        "group",
        "name",
        "source_url",
        "target_date",
        "observed_date",
        "page_title",
        "instrument_identity",
        "read_method",
        "observed_value_field",
        "observed_change_field",
        "observed_headers",
        "observed_row_text",
        "read_status",
        "captured_at_utc",
        "finished_at_utc"
      ],
      "properties": {
        "group": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "source_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "target_date": {
          "type": "string",
          "format": "date"
        },
        "observed_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "page_title": {
          "type": "string"
        },
        "instrument_identity": {
          "type": "string"
        },
        "read_method": {
          "enum": [
            "CHATGPT_WEB_OPEN_HISTORICAL_PAGE",
            "CNN_OFFICIAL_CURRENT_DASHBOARD"
          ]
        },
        "observed_value_field": {
          "type": "string"
        },
        "observed_change_field": {
          "type": "string"
        },
        "observed_headers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "observed_row_text": {
          "type": "string"
        },
        "read_status": {
          "enum": [
            "PAGE_CONTENT_READ_SUCCESS",
            "SOURCE_NO_DATA",
            "MARKET_CLOSED",
            "SOURCE_UPDATE_PENDING",
            "TOOL_READ_FAILURE"
          ]
        },
        "observed_value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "observed_change": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "captured_at_utc": {
          "type": "string"
        },
        "finished_at_utc": {
          "type": "string"
        },
        "web_reader_ref": {
          "type": "string"
        },
        "web_line_start": {
          "type": "integer",
          "minimum": 0
        },
        "web_line_end": {
          "type": "integer",
          "minimum": 0
        },
        "source_timestamp_utc": {
          "type": "string"
        },
        "source_role": {
          "type": "string"
        },
        "evidence_path": {
          "type": "string"
        },
        "observation_record_sha256": {
          "type": "string"
        },
        "market_calendar_status": {
          "enum": [
            "CLOSED"
          ]
        },
        "market_calendar_source_type": {
          "const": "OFFICIAL"
        },
        "market_calendar_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "market_calendar_date": {
          "type": "string",
          "format": "date"
        },
        "market_calendar_evidence": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "string"
        },
        "prior_observation_reused": {
          "type": "boolean"
        },
        "source_page_fetched": {
          "type": "boolean"
        },
        "instrument_identity_status": {
          "type": "string"
        },
        "field_mapping_status": {
          "type": "string"
        },
        "closure_evidence_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "closure_evidence_text": {
          "type": "string"
        },
        "closure_evidence_reader_ref": {
          "type": "string"
        },
        "closure_evidence_line_start": {
          "type": "integer",
          "minimum": 0
        },
        "closure_evidence_line_end": {
          "type": "integer",
          "minimum": 0
        },
        "contract_label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}
